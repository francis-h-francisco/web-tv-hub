{
  "name": "web-tv-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-cost lean-back web TV hub built on iptv-org public data",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:data": "node pipeline/build.mjs --out site/data",
    "build:data:quick": "node pipeline/build.mjs --out site/data --limit 60",
    "test": "node --test pipeline/test.mjs",
    "serve": "python3 -m http.server 8080 --directory site"
  },
  "license": "MIT"
}
